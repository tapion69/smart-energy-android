# LOCAL FILE ONLY. DO NOT COMMIT. Create sdkconfig.credentials from this example.
# This first proof of concept is built with per-installation settings.
CONFIG_ML_WIFI_SSID="MY_WIFI_24GHZ"
CONFIG_ML_WIFI_PASSWORD="MY_WIFI_PASSWORD"
CONFIG_ML_TAILSCALE_AUTH_KEY="tskey-auth-REPLACE-WITH-YOUR-OWN"
CONFIG_SE_JK_IP="192.168.1.53"
CONFIG_SE_JK_READ_CODE="MY_EXISTING_JK_PAIR_CODE"
CONFIG_SE_GATEWAY_TOKEN="REPLACE-WITH-A-LONG-UNIQUE-RANDOM-SECRET"
# Voltronic optional — disabled until a real HTTP API route is established.
CONFIG_SE_VOLT_IP=""
CONFIG_SE_VOLT_READ_PATH=""
CONFIG_SE_VOLT_READ_CODE=""
